# =============================================================================
#  Dossier des médias : AUCUN accès direct.
#  Les fichiers sont diffusés uniquement par /media.php après contrôle
#  de la session et de la date de révélation.
# =============================================================================

Options -Indexes -ExecCGI

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Défense en profondeur : aucun exécutable ne doit être interprété ici.
RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .pl .py .cgi .sh
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
